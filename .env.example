# ===== 骑手招聘 Agent 平台 — 环境变量样例（复制为 .env 后按需修改）=====
# 说明：以下全部是本地开发/演示用的合成配置，不得用于生产。

# --- Docker Compose 端口映射 ---
API_PORT=8000
DB_PORT=55432
CACHE_PORT=56379

# --- 数据库（compose 内部与本地 pytest 共用同一套变量）---
POSTGRES_USER=rider
POSTGRES_PASSWORD=rider_dev_password
POSTGRES_DB=rider
# 本地（宿主机）跑 pytest/uvicorn 时用这个；容器内由 compose 覆盖为 db:5432
DATABASE_URL=postgresql://rider:rider_dev_password@127.0.0.1:55432/rider
# 测试库会被 conftest 自动创建（DROP/CREATE），名字固定：
TEST_DATABASE_URL=postgresql://rider:rider_dev_password@127.0.0.1:55432/rider_test

# --- 缓存（Redis 协议，Valkey 服务端）---
CACHE_URL=redis://127.0.0.1:56379/0

# --- LLM（可插拔）---
# mock = 确定性本地规则引擎，不联网、不需要密钥（默认，测试与干净机器都用它）
# openai = OpenAI 兼容 /chat/completions 接口
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=5

# --- 安全（仅本地开发默认值，生产必须替换）---
JWT_SECRET=dev-only-jwt-secret-change-me
VAULT_KEY=dev-only-vault-key-change-me-32bytes!!
WEBHOOK_SECRET=dev-only-webhook-secret

# --- 启动行为 ---
AUTO_INIT=1
AUTO_SEED=1

# --- CORS（前端 H5/admin 跨端口访问 API；* 仅适合本地演示）---
CORS_ORIGINS=*

# 前端静态站点（H5 + 工作台）对外端口（8080 常被本机代理占用，默认 8081）
WEB_PORT=8081
